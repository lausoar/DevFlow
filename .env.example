# ============================================
# DevFlow 根目录环境变量模板（复制为 .env，.env 已被忽略）
# ============================================
# docker compose 使用（带默认值，未设置时回落到开发默认口令）
DB_PASSWORD=devflow123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MinIO 镜像：默认使用 Chainguard 的公开维护镜像；企业私有仓库可覆盖为内部地址
# MINIO_IMAGE=registry.example.com/devflow/minio:latest

# 后端使用（Spring Boot 直接读取环境变量）
# JWT_SECRET 为 Base64 编码、>= 32 字节；生成方式：openssl rand -base64 48
JWT_SECRET=
# 与 ai-service 的 AI_SERVICE_TOKEN 一致
AI_SERVICE_TOKEN=
# AI 服务地址
AI_SERVICE_URL=http://localhost:8000/api/v1
# 仅限隔离开发/集成环境：重新启用 admin/zhangsan 演示账号；生产必须保持 false
DEVFLOW_SEED_DEMO_ACCOUNTS=false

# 生产环境建议
# LOG_LEVEL=info
# MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
# SWAGGER_ENABLED=false
# CORS_ALLOWED_ORIGINS=https://devflow.example.com
# WS_ALLOWED_ORIGINS=https://devflow.example.com

# 浏览器经同源 Nginx 访问后端与 AI；不要把远端浏览器指向 localhost。
PUBLIC_API_BASE_URL=/api/v1
PUBLIC_AI_BASE_URL=/ai-api/api/v1

# AI 未配置 Key 时使用离线回复。其余厂商参数见 ai-service/.env.example，
# 在根目录 .env 中设置同名变量即可由 docker-compose.prod.yml 转发。
AI_PROVIDER=openai
# OPENAI_API_KEY=
# QWEN_API_KEY=
# EMBEDDING_PROVIDER=api
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
