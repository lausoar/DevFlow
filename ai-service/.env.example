# ============================================
# DevFlow AI Service 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================

# 默认 LLM 提供商：openai / deepseek / qwen / kimi / volcano / glm
AI_PROVIDER=openai

# OpenAI 兼容接口（国内可用 DeepSeek/Kimi/GLM 等兼容端点）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_MODEL=

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Embedding 服务（RAG 知识库检索依赖）
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 基础设施
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=devflow

# Java 后端地址（知识同步回调）
BACKEND_API_URL=http://localhost:8080/api/v1

# 与 backend/src/main/resources/application.yml 中 jwt.secret 保持一致
JWT_SECRET=
