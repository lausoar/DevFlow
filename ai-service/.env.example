# ============================================
# DevFlow AI Service 环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================

# 默认 LLM 提供商：openai / deepseek / qwen / kimi / volcano / glm
AI_PROVIDER=openai

# OpenAI 兼容接口（国内可用 DeepSeek/Kimi/GLM 等兼容端点）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_MODEL=deepseek-v3-250324

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Embedding 服务（RAG 知识库检索依赖）：api=OpenAI 兼容接口，local=本地模型
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# 基础设施
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=devflow

# Java 后端地址（知识同步回调）
BACKEND_API_URL=http://localhost:8080/api/v1

# 与 backend/src/main/resources/application.yml 中 jwt.secret 保持一致
# 用于校验前端携带的用户 JWT（Base64 编码的 HMAC 密钥）
# 留空时所有 /api/v1 接口返回 503（认证 fail-closed），因此必须配置
JWT_SECRET=

# 服务间调用令牌：Java 后端同步知识库时放在 X-Service-Token 头
# 与 backend/src/main/resources/application.yml 的 ai.service.token 保持一致
AI_SERVICE_TOKEN=

# CORS 白名单（逗号分隔的前端地址；不要使用 *）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
